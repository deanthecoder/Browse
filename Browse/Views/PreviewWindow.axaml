<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:Browse.ViewModels"
        x:Class="Browse.Views.PreviewWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="920"
        Height="700"
        MinWidth="500"
        MinHeight="360"
        Title="Browse Preview"
        KeyDown="OnKeyDown">
  <Grid Background="#17191D" RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="#24272D" BorderBrush="#3B4049" BorderThickness="0,0,0,1" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding PreviewSummary}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Open..." Click="OnOpenClicked" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="16">
      <ContentControl x:Name="PreviewHost" />
      <Button x:Name="SourceToggleButton"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              ZIndex="2"
              Classes="chrome"
              Padding="5"
              IsVisible="False"
              Click="OnSourceToggleClicked">
        <Grid>
          <icons:MaterialIcon x:Name="ShowSourceIcon" Kind="CodeTags" Width="18" Height="18" Foreground="#FFFFFF" />
          <icons:MaterialIcon x:Name="ShowRenderedIcon" Kind="EyeOutline" Width="18" Height="18" Foreground="#FFFFFF" IsVisible="False" />
        </Grid>
      </Button>
    </Grid>
  </Grid>
</Window>
