<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BrowseWindowBrush">#0000AA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseTextBrush">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseSidebarBrush">#0000AA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseListBrush">#00008A</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseHeaderBrush">#0000AA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseDialogBrush">#0000AA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowsePreviewBrush">#000055</SolidColorBrush>
  <SolidColorBrush x:Key="BrowsePreviewBorderBrush">#55FFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseDividerBrush">#55FFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseDialogBorderBrush">#55FFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseSubtleBorderBrush">#AAAAAA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseAccentBrush">#55FFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseMutedBrush">#AAAAAA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseSecondaryIconBrush">#AAAAAA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseOverlayButtonBrush">#DD0000AA</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseDestructiveBrush">#FF5555</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseErrorBrush">#FF5555</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseWhiteBrush">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseHoverBrush">#005555</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseSelectionBrush">#005555</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseInactiveSelectionBrush">#555555</SolidColorBrush>
  <SolidColorBrush x:Key="BrowseDropTargetBrush">#005555</SolidColorBrush>
  <FontFamily x:Key="BrowseFontFamily">avares://DTC.AsciiTheme/Assets/Fonts/VGA#PxPlus IBM VGA8</FontFamily>
  <FontWeight x:Key="BrowseHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="BrowseAboutTitleSize">32</x:Double>
  <x:Boolean x:Key="BrowseShowModernSettings">False</x:Boolean>
  <x:Boolean x:Key="BrowseShowAsciiSettings">True</x:Boolean>
  <CornerRadius x:Key="BrowseRadius4">0</CornerRadius>
  <CornerRadius x:Key="BrowseRadius5">0</CornerRadius>
  <CornerRadius x:Key="BrowseRadius6">0</CornerRadius>
  <CornerRadius x:Key="BrowseRadius7">0</CornerRadius>
  <x:Double x:Key="BrowseFontSize10">16</x:Double>
  <x:Double x:Key="BrowseFontSize11">16</x:Double>
  <x:Double x:Key="BrowseFontSize15">16</x:Double>
  <x:Double x:Key="BrowseFontSize17">16</x:Double>
  <x:Double x:Key="BrowseFontSize18">16</x:Double>
  <x:String x:Key="BrowseCloseLabel">X</x:String>
  <x:String x:Key="BrowseFolderArrow">&gt;</x:String>
  <x:Double x:Key="BrowseAboutBodySize">16</x:Double>
</ResourceDictionary>
